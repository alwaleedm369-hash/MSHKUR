NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=https://your-domain.example
MSHKUR_DB_PATH=./data/mshkur.sqlite
MSHKUR_STORAGE_DIR=./storage
# Optional Google OAuth. Leave blank to use local email/password accounts.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Optional local llama.cpp endpoint. Do not point this to a paid hosted API.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_TIMEOUT_MS=30000
