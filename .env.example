NODE_ENV=development
HOST=0.0.0.0
PORT=4174
APP_BASE_URL=http://localhost:3000
MSHKUR_DB_PATH=./data/mshkur.sqlite
MSHKUR_STORAGE_DIR=./storage
MSHKUR_TENANT_STORAGE_LIMIT_BYTES=536870912
# Optional local llama.cpp OpenAI-compatible endpoint; never a paid fallback.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=local-model
LOCAL_LLM_TIMEOUT_MS=30000
# Optional Google OAuth; local email/password authentication works without it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Maps currently use external map links; no Google Maps API key is required.
