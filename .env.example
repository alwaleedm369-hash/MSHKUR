# Demo mode is convenient for the first preview only.
# On a public production website, set AUTH_MODE=password and configure both secrets below.
AUTH_MODE=demo
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-to-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-random-secret-at-least-32-characters
PORT=3000
DATA_DIR=./data
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
APP_BASE_URL=https://your-domain.example
